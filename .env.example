# Basic Django Settings
DEBUG=False
SECRET_KEY=your-secret-key-here
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configurations
DB_ENGINE=django.db.backends.mysql
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Email Settings (Use an App Password for Gmail)
DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here

# Project settings
# Set to True to disable signup and run as a personal blog
PERSONAL_BLOG_MODE=False

# Number of articles per page
ITEMS_PER_PAGE=10

# Social Media Links (leave blank to hide)
SOCIAL_LINK_FACEBOOK=https://facebook.com/yourprofile
SOCIAL_LINK_TWITTER=https://twitter.com/yourprofile
SOCIAL_LINK_LINKEDIN=https://linkedin.com/in/yourprofile
SOCIAL_LINK_INSTAGRAM=https://instagram.com/yourprofile