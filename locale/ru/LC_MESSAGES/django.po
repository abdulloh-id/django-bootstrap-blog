# Sign Up

msgid "Sign Up"
msgstr "Регистрация"

msgid "Create Account"
msgstr "Создать аккаунт"

msgid "Fill in the details below to register"
msgstr "Заполните данные ниже для регистрации"

msgid "I have read and agree to the"
msgstr "Я прочитал(а) и согласен(сна) с"

msgid "Terms of Service"
msgstr "Условиями предоставления услуг"

msgid "Already have an account?"
msgstr "Уже есть аккаунт?"

msgid "Log in"
msgstr "Войти"

msgid "You must agree to the Terms of Service and Privacy Policy to continue."
msgstr ""
"Чтобы продолжить, вы должны согласиться с Условиями использования и "
"Политикой конфиденциальности."

msgid ""
"Your password must contain at least 8 characters and cannot be entirely "
"numeric, too similar to your personal info, or commonly used."
msgstr ""
"Пароль должен содержать не менее 8 символов и не может состоять только из "
"цифр, быть слишком похожим на личные данные или являться широко используемым"
" паролем."

msgid "Required. 150 characters or fewer. Letters, digits and @/./+/-/_ only."
msgstr ""
"Обязательное поле. Не более 150 символов. Только буквы, цифры и символы "
"@/./+/-/_."

msgid "This username is already taken. Please choose another."
msgstr "Это имя пользователя уже занято. Пожалуйста, выберите другое."

msgid "Account created successfully!"
msgstr "Аккаунт успешно создан!"

# Password Reset

msgid "Forgot Password?"
msgstr "Забыли пароль?"

msgid ""
"Enter your email address below and we'll send you instructions to reset your"
" password."
msgstr "Введите email ниже, и мы отправим инструкции для сброса пароля."

msgid ""
"If an account exists with this email, you will receive a password reset link"
" shortly."
msgstr ""
"Если аккаунт с этим email существует, вы скоро получите ссылку для сброса."

msgid "Send Reset Link"
msgstr "Отправить ссылку"

msgid "Need Help?"
msgstr "Нужна помощь?"

msgid "Password Reset Email Sent"
msgstr "Письмо для сброса отправлено"

msgid "Check Your Email"
msgstr "Проверьте почту"

msgid ""
"We've emailed you instructions for setting your password. You should receive"
" them shortly."
msgstr ""
"Мы отправили инструкции по сбросу пароля на вашу почту. Они скоро придут."

msgid ""
"If you don't receive an email, please make sure you've entered the address "
"you registered with, and check your spam folder."
msgstr "Если письмо не пришло, проверьте правильность адреса и папку \"Спам\"."

msgid "Back to Login"
msgstr "Вернуться ко входу"

msgid "Resend Email"
msgstr "Отправить снова"

msgid "Set New Password"
msgstr "Установить новый пароль"

msgid ""
"Please enter your new password twice so we can verify you typed it "
"correctly."
msgstr "Введите новый пароль дважды для проверки."

msgid "Password Requirements"
msgstr "Требования к паролю"

msgid "Password Reset Complete"
msgstr "Сброс пароля завершен"

msgid "Password Reset Successful!"
msgstr "Пароль успешно сброшен!"

msgid ""
"Your password has been set successfully. You can now log in with your new "
"password."
msgstr ""
"Ваш пароль успешно установлен. Теперь вы можете войти с новым паролем."

msgid "Sign In Now"
msgstr "Войти сейчас"

msgid "Keep your new password secure and don't share it with anyone."
msgstr "Храните новый пароль в безопасности и никому его не сообщайте."

# Change Password

msgid "Change Password"
msgstr "Сменить пароль"

msgid "Enter your current password, then your new password twice."
msgstr "Введите текущий пароль, затем дважды новый пароль."

msgid "Update Password"
msgstr "Обновить пароль"

msgid "Back to Profile"
msgstr "Вернуться в профиль"

msgid "Password Tips"
msgstr "Советы по паролю"

msgid "Use at least 8 characters"
msgstr "Используйте минимум 8 символов"

msgid "Mix uppercase and lowercase letters"
msgstr "Смешивайте заглавные и строчные буквы"

msgid "Include numbers and symbols (!@#$%^&*)"
msgstr "Добавьте цифры и символы (!@#$%^&*)"

msgid "Avoid personal information or common words"
msgstr "Избегайте личных данных и распространенных слов"

msgid "Password Updated!"
msgstr "Пароль обновлен!"

msgid ""
"Your password has been changed successfully. You can now sign in with your "
"new password."
msgstr "Ваш пароль успешно изменен. Теперь вы можете войти с новым паролем."

msgid ""
"For security, please remember your new password or store it in a safe place."
msgstr ""
"В целях безопасности запомните новый пароль или сохраните его в надежном "
"месте."

msgid "Your password was successfully updated!"
msgstr "Ваш пароль был успешно изменён!"

